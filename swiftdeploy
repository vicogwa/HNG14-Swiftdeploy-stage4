#!/usr/bin/env python3
"""
swiftdeploy -- declarative deployment CLI with OPA policy gating,
live status dashboard, and audit reporting.
"""

import sys
import os
import subprocess
import time
import json
import re
import shutil
import socket
import tempfile
import urllib.request
import urllib.error
from datetime import datetime, timezone
from pathlib import Path

import yaml
from jinja2 import Environment, FileSystemLoader

# -- Paths ---------------------------------------------------------------------
ROOT         = Path(__file__).parent.resolve()
MANIFEST     = ROOT / "manifest.yaml"
NGINX_CONF   = ROOT / "nginx.conf"
COMPOSE_FILE = ROOT / "docker-compose.yml"
POLICIES_DIR = ROOT / "policies"
HISTORY_FILE = ROOT / "history.jsonl"
AUDIT_FILE   = ROOT / "audit_report.md"

# OPA base URL -- the CLI talks to OPA directly on localhost
OPA_URL      = "http://localhost:8181"

# -- Terminal colours ----------------------------------------------------------
GREEN  = "\033[92m"
RED    = "\033[91m"
YELLOW = "\033[93m"
CYAN   = "\033[96m"
BOLD   = "\033[1m"
RESET  = "\033[0m"

def info(msg):  print(f"{CYAN}[swiftdeploy]{RESET} {msg}")
def ok(msg):    print(f"  {GREEN}[PASS]{RESET} {msg}")
def fail(msg):  print(f"  {RED}[FAIL]{RESET} {msg}")
def warn(msg):  print(f"  {YELLOW}[WARN]{RESET} {msg}")
def fatal(msg): print(f"{RED}[BLOCKED]{RESET} {msg}"); sys.exit(1)


# -- Helpers -------------------------------------------------------------------
def load_manifest() -> dict:
    with open(MANIFEST) as f:
        return yaml.safe_load(f)

def save_manifest(data: dict):
    with open(MANIFEST, "w") as f:
        yaml.dump(data, f, default_flow_style=False)

def run(cmd, **kwargs):
    return subprocess.run(cmd, cwd=ROOT, **kwargs)

def compose(*args):
    return run(["docker", "compose", "-f", str(COMPOSE_FILE), *args], check=True)

def render_templates(data: dict):
    env = Environment(loader=FileSystemLoader(str(ROOT / "templates")))

    t = env.get_template("nginx.conf.j2")
    NGINX_CONF.write_text(t.render(**data))
    info("Generated nginx.conf")

    t = env.get_template("docker-compose.yml.j2")
    COMPOSE_FILE.write_text(t.render(**data))
    info("Generated docker-compose.yml")


# -- OPA helpers ---------------------------------------------------------------
def _opa_query(package: str, input_data: dict) -> dict | None:
    """
    Send input_data to OPA and return the `decision` object from that package.
    Returns None on any network or parse error -- caller must handle gracefully.

    OPA REST API:  POST /v1/data/{package}/decision
    Body:          { "input": { ...your data... } }
    Response:      { "result": { "allow": bool, "violations": [...], "domain": "..." } }
    """
    url = f"{OPA_URL}/v1/data/{package.replace('.', '/')}/decision"
    payload = json.dumps({"input": input_data}).encode()
    req = urllib.request.Request(
        url, data=payload,
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = json.loads(resp.read())
            return body.get("result")
    except urllib.error.URLError as e:
        warn(f"OPA unreachable ({package}): {e.reason}")
        return None
    except Exception as e:
        warn(f"OPA query failed ({package}): {e}")
        return None


def _enforce_policy(decision: dict | None, package: str):
    """
    Inspect an OPA decision object and block (sys.exit) if denied.
    If OPA was unreachable (decision is None), warn but allow through
    so a network blip doesn't permanently lock deployments.
    """
    if decision is None:
        warn(f"Policy check skipped -- OPA did not respond for '{package}'")
        return

    domain = decision.get("domain", package)
    allowed = decision.get("allow", False)
    violations = decision.get("violations", [])

    if allowed:
        ok(f"Policy '{domain}': ALLOWED")
    else:
        print(f"\n{RED}{BOLD}Policy '{domain}': DENIED{RESET}")
        for v in violations:
            print(f"  {RED}x{RESET} {v}")
        print()
        # Log the violation to history
        _append_history({
            "event": "policy_violation",
            "domain": domain,
            "violations": violations,
        })
        fatal(f"Deployment blocked by policy '{domain}'. Fix the issues above and retry.")


# -- History / audit trail -----------------------------------------------------
def _append_history(record: dict):
    """Append one JSON line to history.jsonl with a timestamp."""
    record["ts"] = datetime.now(timezone.utc).isoformat()
    with open(HISTORY_FILE, "a") as f:
        f.write(json.dumps(record) + "\n")

def _read_history() -> list[dict]:
    if not HISTORY_FILE.exists():
        return []
    records = []
    for line in HISTORY_FILE.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                records.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return records


# -- Metrics scraper -----------------------------------------------------------
def _scrape_metrics(nginx_port: int) -> dict:
    """
    Fetch /metrics from the app (via nginx) and parse the Prometheus text format.
    Returns a dict of {metric_name: value} for the metrics we care about.
    """
    url = f"http://localhost:{nginx_port}/metrics"
    try:
        with urllib.request.urlopen(url, timeout=5) as resp:
            text = resp.read().decode()
    except Exception as e:
        warn(f"Could not scrape /metrics: {e}")
        return {}

    result = {}
    for line in text.splitlines():
        if line.startswith("#"):
            continue
        parts = line.split(" ")
        if len(parts) >= 2:
            try:
                result[parts[0]] = float(parts[1])
            except ValueError:
                pass
    return result


def _calculate_error_rate(raw: dict) -> float:
    """
    Error rate = (5xx requests) / (total requests).
    We sum all http_requests_total counters, then sum those with status_code 5xx.
    """
    total = 0.0
    errors = 0.0
    for key, val in raw.items():
        if key.startswith("http_requests_total{"):
            total += val
            if 'status_code="5' in key:
                errors += val
    if total == 0:
        return 0.0
    return errors / total


def _calculate_p99_latency_ms(raw: dict) -> float:
    """
    P99 latency from a Prometheus histogram.
    The histogram stores cumulative bucket counts. The 0.99 quantile bucket
    is the smallest bucket where at least 99% of observations have landed.
    We look for the _bucket lines and find the first one >= 99% of total count.
    """
    buckets = []
    total_count = 0.0

    for key, val in raw.items():
        # e.g. http_request_duration_seconds_bucket{...,le="0.5"} 120.0
        if "http_request_duration_seconds_bucket{" in key:
            le_match = re.search(r'le="([^"]+)"', key)
            if le_match:
                le_str = le_match.group(1)
                if le_str == "+Inf":
                    total_count = val
                else:
                    buckets.append((float(le_str), val))

    if total_count == 0 or not buckets:
        return 0.0

    buckets.sort()
    threshold = 0.99 * total_count
    for le, count in buckets:
        if count >= threshold:
            return le * 1000  # convert seconds to ms

    # If nothing hit threshold, return the largest bucket upper bound
    return buckets[-1][0] * 1000


# -- Subcommands ---------------------------------------------------------------
def cmd_init():
    data = load_manifest()
    render_templates(data)


def cmd_validate():
    passed = True
    data = None

    # 1. Manifest exists and is valid YAML
    try:
        data = load_manifest()
        ok("manifest.yaml exists and is valid YAML")
    except Exception as e:
        fail(f"manifest.yaml exists and is valid YAML: {e}")
        passed = False

    # 2. Required fields present
    if data:
        required = [
            ("services.image", lambda d: d.get("services", {}).get("image")),
            ("services.port",  lambda d: d.get("services", {}).get("port")),
            ("nginx.port",     lambda d: d.get("nginx", {}).get("port")),
            ("network.name",   lambda d: d.get("network", {}).get("name")),
        ]
        all_present = all(fn(data) for _, fn in required)
        if all_present:
            ok("All required fields are present and non-empty")
        else:
            fail("All required fields are present and non-empty")
            passed = False

    # 3. Docker image exists locally
    if data:
        image = data.get("services", {}).get("image", "")
        r = run(["docker", "image", "inspect", image], capture_output=True)
        if r.returncode == 0:
            ok(f"Docker image '{image}' exists locally")
        else:
            fail(f"Docker image '{image}' exists locally -- run: docker build -t {image} ./app")
            passed = False

    # 4. Nginx port not already bound
    if data:
        port = int(data.get("nginx", {}).get("port", 8080))
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            in_use = s.connect_ex(("localhost", port)) == 0
        if not in_use:
            ok(f"Nginx port {port} is free")
        else:
            fail(f"Port {port} is already bound on this host")
            passed = False

    # 5. nginx.conf syntactically valid (stub upstream for offline check)
    if not NGINX_CONF.exists():
        fail("nginx.conf does not exist -- run: ./swiftdeploy init")
        passed = False
    else:
        import re as _re
        patched = _re.sub(r"server\s+app:", "server 127.0.0.1:", NGINX_CONF.read_text())
        with tempfile.NamedTemporaryFile(mode="w", suffix=".conf", delete=False) as tf:
            tf.write(patched)
            tmp_conf = tf.name
        r = run(
            ["docker", "run", "--rm",
             "-v", f"{tmp_conf}:/etc/nginx/conf.d/default.conf:ro",
             "nginx:latest", "nginx", "-t"],
            capture_output=True
        )
        os.unlink(tmp_conf)
        if r.returncode == 0:
            ok("nginx.conf is syntactically valid")
        else:
            fail("nginx.conf failed syntax check:\n" + r.stderr.decode())
            passed = False

    if passed:
        info("All checks passed.")
    else:
        info("One or more checks failed.")
        sys.exit(1)


def cmd_deploy():
    # Step 1: bring up OPA first so I can query it for the policy check
    info("Running init...")
    cmd_init()
    info("Starting OPA for policy check...")
    compose("up", "-d", "opa")

    # Wait up to 15s for OPA to be ready
    opa_ready = False
    for _ in range(15):
        try:
            with urllib.request.urlopen(OPA_URL + "/health", timeout=2) as r:
                if r.status == 200:
                    opa_ready = True
                    break
        except Exception:
            pass
        time.sleep(1)

    if not opa_ready:
        warn("OPA did not become ready in time -- skipping policy check")

    # Step 2: run pre-deploy policy check
    info("Running pre-deploy policy check...")
    disk = shutil.disk_usage("/")
    disk_free_gb = disk.free / (1024 ** 3)

    try:
        cpu_load = os.getloadavg()[0]
    except (AttributeError, OSError):
        cpu_load = 0.0
        warn("CPU load unavailable on this platform -- defaulting to 0.0")

    deploy_input = {
        "disk_free_gb": round(disk_free_gb, 2),
        "cpu_load": round(cpu_load, 2),
        "action": "deploy",
    }
    info(f"Host stats: disk_free={disk_free_gb:.1f}GB  cpu_load={cpu_load:.2f}")

    decision = _opa_query("infrastructure", deploy_input)
    _enforce_policy(decision, "infrastructure")

    # Step 3: policy passed -- bring up the rest of the stack
    info("Bringing up the stack...")
    compose("up", "-d")

    # Wait for healthy
    info("Waiting for health checks (60s timeout)...")
    deadline = time.time() + 60
    data = load_manifest()
    nginx_port = data["nginx"]["port"]
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(
                f"http://localhost:{nginx_port}/healthz", timeout=3
            ) as resp:
                body = json.loads(resp.read())
                if body.get("status") == "ok":
                    info(f"Stack is healthy. Mode: {body.get('mode')}")
                    _append_history({"event": "deploy", "mode": body.get("mode")})
                    return
        except Exception:
            pass
        time.sleep(3)

    fatal("Timeout: health checks did not pass within 60s")

def cmd_promote(mode: str):
    if mode not in ("stable", "canary"):
        print("Usage: swiftdeploy promote [stable|canary]")
        sys.exit(1)

    info(f"Promoting to '{mode}'...")
    data = load_manifest()
    nginx_port = data["nginx"]["port"]

    # Pre-promote policy check (only meaningful when promoting TO stable,
    # i.e. checking if the canary is safe to graduate)
    if mode == "stable":
        info("Running pre-promote policy check (canary safety)...")
        raw = _scrape_metrics(nginx_port)
        error_rate = _calculate_error_rate(raw)
        p99_ms = _calculate_p99_latency_ms(raw)
        info(f"Metrics: error_rate={error_rate:.4f}  p99_latency={p99_ms:.1f}ms")

        promote_input = {
            "error_rate": error_rate,
            "p99_latency_ms": p99_ms,
            "action": "promote_to_stable",
        }
        decision = _opa_query("canary", promote_input)
        _enforce_policy(decision, "canary")

    # Update manifest and restart app container
    data["services"]["mode"] = mode
    save_manifest(data)
    info(f"manifest.yaml updated -> mode: {mode}")

    render_templates(data)
    info("docker-compose.yml regenerated")

    compose("up", "-d", "--no-deps", "--force-recreate", "app")
    info("app container restarted")

    # Confirm
    time.sleep(3)
    try:
        with urllib.request.urlopen(
            f"http://localhost:{nginx_port}/healthz", timeout=10
        ) as resp:
            result = resp.read().decode()
            info(f"Promotion confirmed. /healthz -> {result.strip()}")
    except Exception as e:
        warn(f"/healthz check failed after promote: {e}")

    _append_history({"event": "promote", "mode": mode})


def cmd_teardown(clean: bool = False):
    compose("down", "-v")
    if clean:
        for f in [NGINX_CONF, COMPOSE_FILE]:
            if f.exists():
                f.unlink()
                info(f"Removed {f.name}")
    _append_history({"event": "teardown"})
    info("Done.")


def cmd_status():
    """
    Live-refreshing dashboard. Scrapes /metrics every 5 seconds,
    displays req/s, P99 latency, policy compliance, and appends to history.jsonl.
    Press Ctrl+C to exit.
    """
    data = load_manifest()
    nginx_port = data["nginx"]["port"]

    info("Starting live status dashboard (Ctrl+C to exit)...")
    prev_total = 0.0
    prev_time = time.time()

    try:
        while True:
            os.system("cls" if os.name == "nt" else "clear")
            now = time.time()
            raw = _scrape_metrics(nginx_port)

            # -- Calculate req/s -----------------------------------------------
            total_requests = sum(
                v for k, v in raw.items()
                if k.startswith("http_requests_total{")
            )
            elapsed = now - prev_time
            rps = (total_requests - prev_total) / elapsed if elapsed > 0 else 0
            prev_total = total_requests
            prev_time = now

            # -- Calculate metrics ---------------------------------------------
            error_rate = _calculate_error_rate(raw)
            p99_ms = _calculate_p99_latency_ms(raw)
            uptime = raw.get("app_uptime_seconds", 0)
            mode_val = raw.get("app_mode", 0)
            chaos_val = raw.get("chaos_active", 0)
            mode_str = "canary" if mode_val == 1 else "stable"
            chaos_str = {0: "none", 1: "slow", 2: "error"}.get(int(chaos_val), "unknown")

            # -- Policy compliance ---------------------------------------------
            infra_decision = _opa_query("infrastructure", {
                "disk_free_gb": round(shutil.disk_usage("/").free / (1024**3), 2),
                "cpu_load": 0.0,
                "action": "status_check",
            })
            canary_decision = _opa_query("canary", {
                "error_rate": error_rate,
                "p99_latency_ms": p99_ms,
                "action": "status_check",
            })

            # -- Print dashboard -----------------------------------------------
            print(f"{BOLD}{'-'*55}{RESET}")
            print(f"{BOLD}  SwiftDeploy Status Dashboard{RESET}  [{datetime.now().strftime('%H:%M:%S')}]")
            print(f"{'-'*55}")
            print(f"  Mode:          {CYAN}{mode_str}{RESET}")
            print(f"  Uptime:        {uptime:.0f}s")
            print(f"  Chaos:         {RED if chaos_str != 'none' else GREEN}{chaos_str}{RESET}")
            print(f"{'-'*55}")
            print(f"  Req/s:         {rps:.2f}")
            print(f"  Total reqs:    {total_requests:.0f}")
            print(f"  Error rate:    {RED if error_rate > 0.01 else GREEN}{error_rate*100:.2f}%{RESET}")
            print(f"  P99 latency:   {RED if p99_ms > 500 else GREEN}{p99_ms:.1f}ms{RESET}")
            print(f"{'-'*55}")
            print(f"  Policy Compliance:")

            for label, decision in [("infrastructure", infra_decision), ("canary", canary_decision)]:
                if decision is None:
                    print(f"    {YELLOW}? {label}: OPA unavailable{RESET}")
                elif decision.get("allow"):
                    print(f"    {GREEN}v {label}: PASS{RESET}")
                else:
                    print(f"    {RED}x {label}: FAIL{RESET}")
                    for v in decision.get("violations", []):
                        print(f"      {RED}- {v}{RESET}")

            print(f"{'-'*55}")
            print("  (refreshes every 5s -- Ctrl+C to exit)")

            # Append to history
            _append_history({
                "event": "status_scrape",
                "rps": round(rps, 3),
                "error_rate": round(error_rate, 6),
                "p99_latency_ms": round(p99_ms, 2),
                "mode": mode_str,
                "chaos": chaos_str,
            })

            time.sleep(5)

    except KeyboardInterrupt:
        print(f"\n{CYAN}[swiftdeploy]{RESET} Status dashboard exited.")


def cmd_audit():
    """
    Parse history.jsonl and generate audit_report.md.
    """
    records = _read_history()
    if not records:
        info("No history found. Run the stack and use swiftdeploy status first.")
        return

    lines = [
        "# SwiftDeploy Audit Report",
        f"\nGenerated: {datetime.now().strftime('%Y-%m-%d %H:%M:%S UTC')}",
        f"\nTotal events recorded: {len(records)}",
        "\n---\n",
        "## Timeline\n",
        "| Timestamp | Event | Detail |",
        "|---|---|---|",
    ]

    violations_section = []

    for r in records:
        ts = r.get("ts", "unknown")[:19].replace("T", " ")
        event = r.get("event", "unknown")

        if event == "deploy":
            detail = f"Deployed in `{r.get('mode', '?')}` mode"
        elif event == "promote":
            detail = f"Promoted to `{r.get('mode', '?')}`"
        elif event == "teardown":
            detail = "Stack torn down"
        elif event == "status_scrape":
            detail = (
                f"rps={r.get('rps', 0):.2f}  "
                f"err={r.get('error_rate', 0)*100:.2f}%  "
                f"p99={r.get('p99_latency_ms', 0):.1f}ms  "
                f"chaos={r.get('chaos', 'none')}"
            )
        elif event == "policy_violation":
            detail = f"**BLOCKED** by `{r.get('domain', '?')}` policy"
            for v in r.get("violations", []):
                violations_section.append(f"- `{ts}` [{r.get('domain')}] {v}")
        else:
            detail = json.dumps({k: v for k, v in r.items() if k not in ("ts", "event")})

        lines.append(f"| {ts} | {event} | {detail} |")

    lines.append("\n---\n")
    lines.append("## Policy Violations\n")

    if violations_section:
        lines.append("The following policy violations were recorded:\n")
        lines.extend(violations_section)
    else:
        lines.append("_No policy violations recorded._")

    AUDIT_FILE.write_text("\n".join(lines) + "\n")
    info(f"Audit report written to {AUDIT_FILE}")


# -- Entry point ---------------------------------------------------------------
def main():
    args = sys.argv[1:]
    if not args:
        print("Usage: swiftdeploy [init|validate|deploy|promote|teardown|status|audit]")
        sys.exit(1)

    cmd = args[0]
    if cmd == "init":
        cmd_init()
    elif cmd == "validate":
        cmd_validate()
    elif cmd == "deploy":
        cmd_deploy()
    elif cmd == "promote":
        cmd_promote(args[1] if len(args) > 1 else "")
    elif cmd == "teardown":
        cmd_teardown("--clean" in args)
    elif cmd == "status":
        cmd_status()
    elif cmd == "audit":
        cmd_audit()
    else:
        print(f"Unknown subcommand: {cmd}")
        sys.exit(1)


if __name__ == "__main__":
    main()
